[Unit]
Description=SocTalk first-boot setup wizard (collects config, exits)
# Start on a normal boot via multi-user.target so the wizard comes up whether
# or not cloud-init runs. Two hard constraints shaped this:
#  - MUST NOT be WantedBy=cloud-init.target: on an OVA deploy with no cloud-init
#    datasource (the normal ESXi/vSphere case) cloud-init disables itself,
#    cloud-init.target never activates, and the unit would never start.
#  - MUST NOT order After=cloud-init.target while WantedBy=multi-user.target:
#    when cloud-init IS present that forms multi-user → this unit → cloud-init
#    → multi-user, an ordering cycle systemd breaks by silently DELETING our
#    job (both this and firstboot get skipped). So we do NOT reference
#    cloud-init.target at all. In the headless cloud-init path the wizard may
#    start before a cloud-init-supplied values.yaml lands and simply idle on
#    :8443 waiting for input that never comes; that is harmless because
#    firstboot picks up values.yaml on its own (it polls, see firstboot.sh).
After=network-online.target
Wants=network-online.target
# Skip entirely on any subsequent boot once a sentinel exists OR
# values.yaml is already present.
ConditionPathExists=!/var/lib/soctalk-firstboot.done
ConditionPathExists=!/var/lib/soctalk-wizard.done
ConditionPathExists=!/etc/soctalk/values.yaml

[Service]
Type=simple
ExecStart=/usr/local/bin/soctalk-setup-wizard
Restart=on-failure
RestartSec=10
StandardOutput=journal+console
StandardError=journal+console

# Hardening (be explicit, not handwave).
# We need root because we write to /etc/soctalk and /var/lib, but we
# don't need most capabilities.
User=root
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_CHOWN CAP_DAC_OVERRIDE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# We need to write these specific paths.
ReadWritePaths=/etc/soctalk /var/log /var/lib/soctalk-wizard /var/lib
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictSUIDSGID=true
RestrictRealtime=true

TimeoutStartSec=infinity

[Install]
WantedBy=multi-user.target
